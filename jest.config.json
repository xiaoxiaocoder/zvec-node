{
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/tests/*.test.ts",
    "<rootDir>/tests/**/*.test.ts",
    "<rootDir>/tests/*.test.js",
    "<rootDir>/tests/**/*.test.js"
  ],
  "modulePathIgnorePatterns": [
    "<rootDir>/build/"
  ],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "diagnostics": { "ignoreCodes": [151002] } }]
  }
}